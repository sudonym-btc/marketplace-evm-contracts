{
  "name": "@sudonym-btc/marketplace-evm-contracts",
  "version": "0.1.0",
  "description": "Shared marketplace escrow contract source, ABI, artifacts, and bytecode hash registry.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudonym-btc/marketplace-evm-contracts.git"
  },
  "files": [
    "artifacts",
    "contracts",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./multi-escrow": {
      "types": "./dist/multiEscrow.d.ts",
      "import": "./dist/multiEscrow.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./artifacts/MultiEscrow.json": "./artifacts/MultiEscrow.json",
    "./artifacts/MultiEscrow.abi.json": "./artifacts/MultiEscrow.abi.json",
    "./contracts/MultiEscrow.sol": "./contracts/MultiEscrow.sol"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "build:artifacts": "npm run compile && npm run generate",
    "generate": "node scripts/generate.mjs",
    "sync:multi-escrow": "node scripts/sync-multi-escrow.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "docs": "npm run docs:api",
    "docs:api": "typedoc --plugin typedoc-plugin-markdown --tsconfig tsconfig.json --name \"Marketplace EVM Contracts\" --out docs/reference --readme none --githubPages false --hideBreadcrumbs true --hidePageHeader true --disableSources src/index.ts",
    "test": "node --test test/*.test.mjs && npm run test:solidity",
    "test:solidity": "docker run --rm --platform linux/amd64 -v \"$PWD/../..:/workspace\" -w /workspace/dependencies/marketplace-evm-contracts boltz/foundry@sha256:790a32fde1bc937e6c0ecfa9df0c37dbae5c940c1f97b20cc27a22cc3d080a5f forge test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "solc": "^0.8.35",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
